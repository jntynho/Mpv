+// Preserve queued samples on user pause; reset() is reserved for seeks/stops.
+static bool set_pause(struct ao *ao, bool paused)
+{
+    struct priv *p = ao->priv;
+    SLresult res = (*p->play)->SetPlayState(p->play,
+                          paused ? SL_PLAYSTATE_PAUSED : SL_PLAYSTATE_PLAYING);
+    if (res != SL_RESULT_SUCCESS) {
+        MP_ERR(ao, "Failed to change native pause state: %d\n", res);
+        ao_request_reload(ao);
+        return false;
+    }
+    return true;
+}
+
 static void resume(struct ao *ao)
 {
     struct priv *p = ao->priv;
+    // A seek/reset can clear hw_paused while the OpenSL player remains paused.
+    // Every fresh start must resume the device before feeding its first buffer.
+    if (!set_pause(ao, false))
+        return;
     buffer_callback(p->buffer_queue, ao);
 }
 
